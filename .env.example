# Local development settings.
#   cp .env.example .env
# The Makefile loads .env automatically. Never commit .env.
# Production values live in Railway's environment variables.

# --- Django -----------------------------------------------------------------
DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=dev-only-change-me
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# Leave PGHOST unset to use SQLite locally.
# PGHOST=
# PGDATABASE=
# PGUSER=
# PGPASSWORD=
# PGPORT=5432

# --- Email ------------------------------------------------------------------
# The console backend is the default when DEBUG is on.
# To view real HTML mails locally, run Mailpit and uncomment:
#   docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=SwedeSweets <no-reply@swedesweets.local>

# --- Payments ---------------------------------------------------------------
# fake  = local payment page with Pay/Decline buttons (DEBUG only)
# sumup = SumUp Online Payments (requires the keys below)
PAYMENT_PROVIDER=fake
# SUMUP_API_KEY=
# SUMUP_MERCHANT_CODE=
